[Unit]
Description=gsnote Telegram Bot (queue-only)
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/path/to/gsnote
EnvironmentFile=%h/.config/gsnote/.env
ExecStart=/path/to/gsnote/gsnote
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

# Install this as a SECOND user service sharing the same env file. Copy this
# file to ~/.config/systemd/user/gsnote-worker.service and change ExecStart:
# ExecStart=/path/to/gsnote/gsnote worker
# Enable both units: systemctl --user enable --now gsnote gsnote-worker
