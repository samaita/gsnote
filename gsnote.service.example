[Unit]
Description=gsnote Telegram Bot
# GSNOTE_ROOT is configured in %h/.config/gsnote/.env; Inbox/Voices and
# Inbox/Texts are created beneath that data root.
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/path/to/gsnote
EnvironmentFile=%h/.config/gsnote/.env
ExecStart=/path/to/gsnote/gsnote
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
