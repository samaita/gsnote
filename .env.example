# gsnote — Telegram voice notes, saved locally and transcribed asynchronously.
# `GSNOTE_ROOT` must point to the existing notes directory to preserve old notes.
# The Telegram process only stores and queues audio; the worker runs Whisper.

# --- Telegram process ---
TELEGRAM_BOT_TOKEN=
WHITELIST_TELEGRAM_ID=

# --- Persistent data directory ---
# For an existing installation, retain its current GSNOTE_ROOT value.
GSNOTE_ROOT=

# --- Separate transcription worker ---
TRANSCRIBER_BINARY=whisper-cli
TRANSCRIBER_MODEL=models/ggml-small-q5_1.bin
TRANSCRIBER_THREADS=2
# English is the default. Set another ISO-639-1 code only intentionally.
TRANSCRIBER_LANGUAGE=en
