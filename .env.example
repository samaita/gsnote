# gsnote — voice-only notes. Telegram voice note -> raw audio + transcript.

# --- Telegram (required) ---
TELEGRAM_BOT_TOKEN=
WHITELIST_TELEGRAM_ID=

# --- gsnote folder (required) ---
# Single root holding everything: audio files, transcript notes, ID counter.
GSNOTE_ROOT=

# --- Local transcription (required) ---
# whisper.cpp CLI executable name or absolute path.
TRANSCRIBER_BINARY=whisper-cli
# Path to a downloaded whisper.cpp GGML model.
TRANSCRIBER_MODEL=models/ggml-small-q5_1.bin
# Optional. Omit or leave empty to let whisper-cli choose its thread count.
TRANSCRIBER_THREADS=2
# Optional ISO-639-1 code. Empty enables auto-detection.
TRANSCRIBER_LANGUAGE=id
