# gsnote — voice-only notes. Telegram voice note -> raw audio + transcript.

# --- Telegram (required) ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
WHITELIST_TELEGRAM_ID=your_telegram_id_from_userinfobot

# --- gsnote folder (required) ---
# Single root holding everything: audio files, transcript notes, ID counter.
GSNOTE_ROOT=/path/to/your/notes

# --- ElevenLabs (required for voice capture) ---
ELEVEN_API_KEY=your_elevenlabs_api_key
# Optional: default scribe_v1
ELEVEN_MODEL=scribe_v1
# Optional: ISO-639-1 like "id" or "en". Empty = auto-detect.
ELEVEN_LANGUAGE=
