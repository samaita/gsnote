# gsnote — voice-only notes. Telegram voice note -> raw audio + transcript.

# --- Telegram (required) ---
TELEGRAM_BOT_TOKEN=
WHITELIST_TELEGRAM_ID=

# --- gsnote folder (required) ---
# Single root holding everything: audio files, transcript notes, ID counter.
# For Docker Compose, this MUST be an absolute directory on the host machine.
# Create it before starting; Compose bind-mounts it at /data in the container.
GSNOTE_ROOT=/home/user/samaita/workspace/obsidian-sync/Voice

# --- Local transcription (required) ---
# whisper.cpp CLI executable name or absolute path.
TRANSCRIBER_BINARY=whisper-cli
# Path to a downloaded whisper.cpp GGML model. Compose treats this as a host
# path and bind-mounts the file read-only inside the container.
TRANSCRIBER_MODEL=models/ggml-small-q5_1.bin
# Optional. Omit or leave empty to let whisper-cli choose its thread count.
TRANSCRIBER_THREADS=2
# Optional ISO-639-1 code. Empty enables auto-detection.
TRANSCRIBER_LANGUAGE=id

# --- Docker Compose only (optional) ---
# Set these to `id -u` and `id -g` so bind-mounted notes belong to your user.
GSNOTE_UID=1000
GSNOTE_GID=1000
